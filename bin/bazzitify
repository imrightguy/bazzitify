#!/usr/bin/env bash
# bazzitify — main entry point

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULES_DIR="$SCRIPT_DIR/../modules"
STATE_DIR="$HOME/.local/state/bazzitify"
LOG_FILE="$STATE_DIR/applied.log"
CONFIG_DIR="$HOME/.config/bazzitify/profiles"

mkdir -p "$STATE_DIR"
mkdir -p "$CONFIG_DIR"

# JSON output mode
# 0 = off, 1 = compact, 2 = pretty
JSON_MODE=0

# Read all modules and their dependencies, output topological order
# Usage: topological_order [apply|undo]
# For apply: dependencies first
# For undo: reverse (dependents first)
topological_order() {
  local action="${1:-apply}"
  local tmpdir
  tmpdir=$(mktemp -d)
  trap 'rm -rf "$tmpdir"' RETURN

  # Create a temp file with module name and its depends
  for f in "$MODULES_DIR"/*.sh; do
    [[ -e "$f" ]] || continue
    name=$(basename "$f" .sh)
    # Prefer # requires:, fallback to # depends:
    deps=$(grep -m1 '^# requires:' "$f" | cut -d: -f2- | xargs || true)
    if [[ -z "$deps" ]]; then
      deps=$(grep -m1 '^# depends:' "$f" | cut -d: -f2- | xargs || true)
    fi
    echo "$name $deps" >> "$tmpdir/deps.txt"
  done

  # Kahn's algorithm in bash
  declare -A adj
  declare -A indegree
  declare -A modules

  # Initialize
  while read -r name deps; do
    [[ -z "$name" ]] && continue
    modules["$name"]=1
    indegree["$name"]=0
    adj["$name"]=""
  done < "$tmpdir/deps.txt"

  # Build graph
  while read -r name deps; do
    [[ -z "$name" ]] && continue
    for dep in $deps; do
      if [[ -z "${modules[$dep]:-}" ]]; then
        echo "Error: module '$name' depends on unknown module '$dep'" >&2
        exit 3
      fi
      adj["$dep"]="${adj[$dep]} $name"
      indegree["$name"]=$((indegree["$name"] + 1))
    done
  done < "$tmpdir/deps.txt"

  # Queue of nodes with indegree 0
  local queue=()
  for name in "${!modules[@]}"; do
    if [[ ${indegree[$name]} -eq 0 ]]; then
      queue+=("$name")
    fi
  done

  local sorted=()
  while [[ ${#queue[@]} -gt 0 ]]; do
    local u="${queue[0]}"
    queue=("${queue[@]:1}")
    sorted+=("$u")
    for v in ${adj[$u]}; do
      indegree["$v"]=$((indegree["$v"] - 1))
      if [[ ${indegree[$v]} -eq 0 ]]; then
        queue+=("$v")
      fi
    done
  done

  if [[ ${#sorted[@]} -ne ${#modules[@]} ]]; then
    # Cycle detected
    local remaining=()
    for name in "${!modules[@]}"; do
      if [[ ${indegree[$name]} -gt 0 ]]; then
        remaining+=("$name")
      fi
    done
    echo "Error: dependency cycle detected involving: ${remaining[*]}" >&2
    exit 3
  fi

  if [[ "$action" == "undo" ]]; then
    # Reverse for undo
    for ((i=${#sorted[@]}-1; i>=0; i--)); do
      echo "${sorted[i]}"
    done
  else
    printf '%s\n' "${sorted[@]}"
  fi
}

# JSON output helpers
json_escape() {
  # Escape string for JSON using jq
  jq -n --arg v "$1" '$v'
}

json_array_from_list() {
  # Convert newline-separated list to JSON array
  local items=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && items+=("$line")
  done
  printf '%s\n' "${items[@]}" | jq -R . | jq -s .
}

output_json() {
  local data="$1"
  if [[ $JSON_MODE -eq 2 ]]; then
    echo "$data" | jq .
  else
    echo "$data" | jq -c .
  fi
}

# Check if module has apply/undo functions
module_has_apply() {
  local name="$1"
  local f="$MODULES_DIR/$name.sh"
  [[ -f "$f" ]] || return 1
  grep -q '^module_apply()' "$f"
}

module_has_undo() {
  local name="$1"
  local f="$MODULES_DIR/$name.sh"
  [[ -f "$f" ]] || return 1
  grep -q '^module_undo()' "$f"
}

# Get module description
module_desc() {
  local f="$1"
  grep -m1 '^# desc:' "$f" | cut -d: -f2- | xargs || true
}

# Get module long description as JSON array
module_long_json() {
  local f="$1"
  local long_lines=()
  # Extract # long: lines
  while IFS= read -r line; do
    [[ -n "$line" ]] && long_lines+=("$line")
  done < <(grep '^# long:' "$f" | cut -d: -f2- | sed 's/^ *//' || true)
  printf '%s\n' "${long_lines[@]}" | jq -R . | jq -s .
}

# Get module dependencies as JSON array
module_deps_json() {
  local f="$1"
  local deps
  deps=$(grep -m1 '^# requires:' "$f" | cut -d: -f2- | xargs || true)
  if [[ -z "$deps" ]]; then
    deps=$(grep -m1 '^# depends:' "$f" | cut -d: -f2- | xargs || true)
  fi
  if [[ -n "$deps" ]]; then
    printf '%s\n' $deps | jq -R . | jq -s .
  else
    echo '[]'
  fi
}

module_is_applied() {
  local name="$1"
  [[ -f "$LOG_FILE" ]] && grep -Fq " $name" "$LOG_FILE"
}

list_modules() {
  if [[ $JSON_MODE -eq 0 ]]; then
    echo "Available modules:"
    for f in "$MODULES_DIR"/*.sh; do
      [[ -e "$f" ]] || { echo "  (none yet)"; return; }
      desc=$(module_desc "$f")
      deps=$(grep -m1 '^# requires:' "$f" | cut -d: -f2- | xargs || true)
      if [[ -z "$deps" ]]; then
        deps=$(grep -m1 '^# depends:' "$f" | cut -d: -f2- | xargs || true)
      fi
      if [[ -n "$deps" ]]; then
        printf '  %-20s %s (depends: %s)\n' "$(basename "$f" .sh)" "$desc" "$deps"
      else
        printf '  %-20s %s\n' "$(basename "$f" .sh)" "$desc"
      fi
    done
  else
    # JSON output
    local modules_json=()
    for f in "$MODULES_DIR"/*.sh; do
      [[ -e "$f" ]] || continue
      local name=$(basename "$f" .sh)
      local desc=$(module_desc "$f")
      local long_json=$(module_long_json "$f")
      local deps_json=$(module_deps_json "$f")
      local applied_status=false
      module_is_applied "$name" && applied_status=true

      local module_json
      module_json=$(jq -n \
        --arg name "$name" \
        --arg desc "$desc" \
        --argjson long_desc "$long_json" \
        --argjson applied_status "$applied_status" \
        --argjson requires "$deps_json" \
        '{name: $name, desc: $desc, long_desc: $long_desc, applied_status: $applied_status, requires: $requires}')
      modules_json+=("$module_json")
    done
    # Combine into array
    printf '%s\n' "${modules_json[@]}" | jq -s .
  fi
}

run_module() {
  local name="$1"; shift || true
  local f="$MODULES_DIR/$name.sh"
  if [[ ! -f "$f" ]]; then
    echo "Unknown module: $name" >&2; exit 1
  fi
  if [[ $JSON_MODE -eq 0 ]]; then
    echo "==> $name"
  fi
  # shellcheck disable=SC1090
  source "$f"
  local start_time
  start_time=$(date +%s%3N)
  local output
  local exit_code=0
  if declare -F "module_apply" >/dev/null; then
    output=$(module_apply "$@" 2>&1) || exit_code=$?
  else
    output="(module defines no module_apply, skipped)"
    exit_code=1
  fi
  local end_time
  end_time=$(date +%s%3N)
  local duration_ms=$((end_time - start_time))

  if [[ $JSON_MODE -eq 0 ]]; then
    for line in $output; do
      echo "$line"
    done
    if [[ $exit_code -eq 0 ]]; then
      echo "$(date -Is) $name" >> "$LOG_FILE"
    fi
  fi

  if [[ $JSON_MODE -ne 0 ]]; then
    local success=$([[ $exit_code -eq 0 ]] && echo true || echo false)
    local result
    result=$(jq -n \
      --arg module "$name" \
      --arg action "apply" \
      --argjson success "$success" \
      --arg output "$output" \
      --arg error "$([ $exit_code -eq 0 ] && echo null || echo "$output")" \
      --argjson duration_ms "$duration_ms" \
      '{module: $module, action: $action, success: $success, output: $output, error: $error, duration_ms: $duration_ms}')
    output_json "$result"
  fi

  # Map module execution failures to exit code 1.
  if [[ $exit_code -ne 0 ]]; then
    return 1
  fi
  return 0
}

undo_module() {
  local name="$1"
  local f="$MODULES_DIR/$name.sh"
  [[ -f "$f" ]] || { echo "Unknown module: $name" >&2; exit 1; }
  # shellcheck disable=SC1090
  source "$f"
  local start_time
  start_time=$(date +%s%3N)
  local output
  local exit_code=0
  if declare -F "module_undo" >/dev/null; then
    output=$(module_undo 2>&1) || exit_code=$?
  else
    output="Module $name has no undo — skipping."
    exit_code=1
  fi
  local end_time
  end_time=$(date +%s%3N)
  local duration_ms=$((end_time - start_time))

  if [[ $JSON_MODE -eq 0 ]]; then
    for line in $output; do
      echo "$line"
    done
  fi

  if [[ $JSON_MODE -ne 0 ]]; then
    local success=$([[ $exit_code -eq 0 ]] && echo true || echo false)
    local result
    result=$(jq -n \
      --arg module "$name" \
      --arg action "undo" \
      --argjson success "$success" \
      --arg output "$output" \
      --arg error "$([ $exit_code -eq 0 ] && echo null || echo "$output")" \
      --argjson duration_ms "$duration_ms" \
      '{module: $module, action: $action, success: $success, output: $output, error: $error, duration_ms: $duration_ms}')
    output_json "$result"
  fi

  # Map module execution failures to exit code 1.
  if [[ $exit_code -ne 0 ]]; then
    return 1
  fi
  return 0
}

dry_run_module() {
  local name="${1:-}"
  if [[ $JSON_MODE -eq 0 ]]; then
    if [[ -n "$name" ]]; then
      echo "DRY RUN — module: $name"
      topological_order apply | grep -E "^$name$|^$name " || echo "  $name"
    else
      echo "DRY RUN — modules that would run (in dependency order):"
      topological_order apply
    fi
  else
    # JSON dry-run: show planned execution order with module details
    local plan=()
    if [[ -n "$name" ]]; then
      # Module-specific dry-run
      local f_mod="$MODULES_DIR/$name.sh"
      local would_apply=false
      local commands=()
      local warnings=()
      if [[ -f "$f_mod" ]]; then
        if grep -q '^module_apply()' "$f_mod"; then
          would_apply=true
        fi
        commands+=("Would run module_apply for $name")
        if grep -q 'sudo' "$f_mod"; then
          warnings+=("Requires sudo privileges")
        fi
      fi
      local plan_json
      plan_json=$(jq -n \
        --arg module "$name" \
        --argjson would_apply "$would_apply" \
        --argjson commands "$(printf '%s\n' "${commands[@]}" | jq -R . | jq -s .)" \
        --argjson warnings "$(printf '%s\n' "${warnings[@]}" | grep -v '^$' | jq -R . | jq -s .)" \
        '{module: $module, would_apply: $would_apply, commands: $commands, warnings: $warnings}')
      plan+=("$plan_json")
    else
      # Full dry-run: all modules in dependency order
      local sorted
      mapfile -t sorted < <(topological_order apply)
      for mod in "${sorted[@]}"; do
        local f_mod="$MODULES_DIR/$mod.sh"
        local would_apply=false
        local commands=()
        local warnings=()
        if [[ -f "$f_mod" ]]; then
          if grep -q '^module_apply()' "$f_mod"; then
            would_apply=true
          fi
          commands+=("Would run module_apply for $mod")
          if grep -q 'sudo' "$f_mod"; then
            warnings+=("Requires sudo privileges")
          fi
        fi
        local plan_json
        plan_json=$(jq -n \
          --arg module "$mod" \
          --argjson would_apply "$would_apply" \
          --argjson commands "$(printf '%s\n' "${commands[@]}" | jq -R . | jq -s .)" \
          --argjson warnings "$(printf '%s\n' "${warnings[@]}" | grep -v '^$' | jq -R . | jq -s .)" \
          '{module: $module, would_apply: $would_apply, commands: $commands, warnings: $warnings}')
        plan+=("$plan_json")
      done
    fi
    printf '%s\n' "${plan[@]}" | jq -s .
  fi
}

# Profile subcommands
profile_export() {
  local name="${1:-}"
  [[ -n "$name" ]] || { echo "Usage: bazzitify profile export <name>" >&2; exit 1; }

  # Use the Rust binary for profile operations
  "$SCRIPT_DIR/bazzitify-profile" export "$name"
}

profile_import() {
  local file="${1:-}"
  [[ -n "$file" ]] || { echo "Usage: bazzitify profile import <file>" >&2; exit 1; }

  "$SCRIPT_DIR/bazzitify-profile" import "$file"
}

profile_list() {
  "$SCRIPT_DIR/bazzitify-profile" list
}

# Parse global --json flag
# Returns remaining args via global PARSED_ARGS array
PARSED_ARGS=()
parse_json_flag() {
  local args=("$@")
  PARSED_ARGS=()
  for arg in "${args[@]}"; do
    case "$arg" in
      --json)
        JSON_MODE=1
        ;;
      --json=pretty)
        JSON_MODE=2
        ;;
      --json=compact)
        JSON_MODE=1
        ;;
      --json=*)
        echo "Unknown --json value: $arg. Use --json, --json=compact, or --json=pretty" >&2
        exit 1
        ;;
      *)
        PARSED_ARGS+=("$arg")
        ;;
    esac
  done
}

# Main command dispatch
main() {
  # Parse --json flag first
  local args=("$@")
  parse_json_flag "${args[@]}"
  set -- "${PARSED_ARGS[@]}"

  case "${1:-}" in
    --list|-l)
      list_modules
      ;;
    --dry-run|-n)
      dry_run_module "${2:-}"
      ;;
    undo)
      if [[ -n "${2:-}" ]]; then
        undo_module "$2"
      else
        echo "Usage: bazzitify undo <module>" >&2
        exit 2
      fi
      ;;
    --all)
      echo "Applying all modules in dependency order..."
      topological_order apply | while IFS= read -r mod; do
        run_module "$mod"
      done
      ;;
    profile)
      subcmd="${2:-}"
      case "$subcmd" in
        export) profile_export "${3:-}" ;;
        import) profile_import "${3:-}" ;;
        list) profile_list ;;
        *) echo "Usage: bazzitify profile <export|import|list>" >&2; exit 1 ;;
      esac
      ;;
    "")
      echo "bazzitify — Bazzite-style gaming optimization for mutable distros"
      echo
      echo "Usage: bazzitify <module|--all|--list|--dry-run|undo <module>|profile <export|import|list>>"
      echo
      echo "Options:"
      echo "  --json              Output JSON (compact)"
      echo "  --json=pretty       Output JSON (pretty-printed)"
      echo
      list_modules
      ;;
    *)
      run_module "$1" "${@:2}"
      ;;
  esac
}

main "$@"