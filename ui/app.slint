import { Button, CheckBox, ScrollView, ComboBox } from "std-widgets.slint";

export struct ModuleInfo {
    name: string,
    description: string,
    details: string,
    selected: bool,
    status: string,
}

// ── Palette ──
global Palette {
    out property <color> base: #1e1e2e;
    out property <color> panel: #181825;
    out property <color> surface: #313244;
    out property <color> overlay: #45475a;
    out property <color> text: #cdd6f4;
    out property <color> subtext: #a6adc8;
    out property <color> faint: #6c7086;
    out property <color> accent: #cba6f7;
    out property <color> green: #a6e3a1;
    out property <color> red: #f38ba8;
    out property <color> yellow: #f9e2af;
}

// Sidebar nav row: hover highlight, selected state, optional trailing pill.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    ta := TouchArea {
        clicked => { root.activated(); }
        mouse-cursor: pointer;
    }
    background: root.selected ? Palette.overlay : (ta.has-hover ? Palette.surface : transparent);
    height: 32px;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 10px;
        Text {
            text: root.label;
            color: Palette.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    callback activated();
}


export component AppWindow inherits Window {
    title: "bazzitify";
    min-width: 760px;
    min-height: 500px;
    preferred-width: 1150px;
    preferred-height: 740px;
    background: Palette.base;

    // Resizable panes
    in-out property <length> sidebar-width: 250px;
    in-out property <length> log-height: 170px;

    in property <[ModuleInfo]> modules;
    in-out property <int> current-page;   // index into modules; -1 = overview
    in-out property <string> log-text;
    in property <bool> running;
    in property <string> distro-info;
    in-out property <bool> dry-run;
    in-out property <[string]> profiles;
    in-out property <string> selected-profile;

    callback select-module(int);
    callback apply-module(int);
    callback undo-module(int);
    callback apply-selected();
    callback undo-selected();
    callback select-all(bool);
    callback clear-selection();
    callback export-profile(string);
    callback import-profile(string);
    callback load-profiles();

    public function append-log(line: string) {
        root.log-text += line + "\n";
    }

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            spacing: 0;

            // ── Sidebar ──
            Rectangle {
                width: root.sidebar-width;
                background: Palette.panel;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "bazzitify";
                        font-size: 18px;
                        font-weight: 800;
                        color: Palette.accent;
                    }
                    Text {
                        text: root.distro-info;
                        font-size: 10px;
                        color: Palette.faint;
                    }

                    Rectangle { height: 2px; }

                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: "Export";
                            enabled: !root.running;
                            clicked => { root.export-profile(root.selected-profile); }
                        }
                        Button {
                            text: "Import";
                            enabled: !root.running;
                            clicked => { root.import-profile(""); }
                        }
                        Button {
                            text: "Refresh";
                            enabled: !root.running;
                            clicked => { root.load-profiles(); }
                        }
                    }

                    Rectangle { height: 4px; }

                    NavItem {
                        label: "Overview";
                        selected: root.current-page < 0;
                        activated => { root.select-module(-1); }
                    }

                    for m[i] in modules: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: root.current-page == i ? Palette.overlay : (row-ta.has-hover ? Palette.surface : transparent);
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 8px;
                            CheckBox {
                                checked <=> m.selected;
                                enabled: !root.running;
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: m.name;
                                    color: Palette.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                            }
                            if m.status == "applied": Rectangle {
                                width: 20px;
                                border-radius: 10px;
                                background: #a6e3a133;
                                Text { text: "✓"; color: Palette.green; font-size: 11px;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if m.status != "" && m.status != "applied": Rectangle {
                                width: 20px;
                                border-radius: 10px;
                                background: #f38ba833;
                                Text { text: "✗"; color: Palette.red; font-size: 11px;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        row-ta := TouchArea {
                            clicked => { root.select-module(i); }
                            mouse-cursor: pointer;
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    CheckBox {
                        text: "dry-run";
                        checked <=> root.dry-run;
                        enabled: !root.running;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: "Apply Selected";
                            primary: true;
                            enabled: !root.running;
                            clicked => { root.apply-selected(); }
                        }
                        Button {
                            text: "Undo Selected";
                            enabled: !root.running;
                            clicked => { root.undo-selected(); }
                        }
                    }
                    Text {
                        text: root.running ? "⟳ working…" : "";
                        color: Palette.yellow;
                        font-size: 11px;
                    }
                }
            }

            // ── Sidebar resize handle ──
            Rectangle {
                width: 5px;
                background: split-ta.has-hover || split-ta.pressed ? Palette.accent : transparent;
                split-ta := TouchArea {
                    property <length> start-width;
                    property <length> press-x;
                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down {
                            self.start-width = root.sidebar-width;
                            self.press-x = self.mouse-x;
                        }
                    }
                    moved => {
                        root.sidebar-width = Math.max(200px, Math.min(420px,
                            self.start-width + (self.mouse-x - self.press-x)));
                    }
                    mouse-cursor: col-resize;
                }
            }

            // ── Main pane ──
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.base;

                if root.current-page < 0: ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;

                        Text {
                            text: "Modules";
                            font-size: 22px;
                            font-weight: 800;
                            color: Palette.text;
                        }
                        Text {
                            text: "Select a module in the sidebar to see what it does before applying.";
                            color: Palette.subtext;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Rectangle { height: 8px; }

                        for m[i] in modules: Rectangle {
                            height: 64px;
                            border-radius: 8px;
                            row-hover := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-module(i); }
                            }
                            background: row-hover.has-hover ? Palette.overlay : Palette.surface;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: m.name;
                                        color: Palette.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: m.description;
                                        color: Palette.subtext;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Open";
                                        clicked => { root.select-module(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.current-page >= 0 && root.current-page < modules.length: Rectangle {
                    property <ModuleInfo> mod: modules[root.current-page];

                    ScrollView {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: mod.name;
                                    font-size: 22px;
                                    font-weight: 800;
                                    color: Palette.text;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        border-radius: 11px;
                                        background: mod.status == "applied" ? #a6e3a155 :
                                                    (mod.status == "running…" ? #f9e2af55 : Palette.surface);
                                        width: 92px;
                                        height: 22px;
                                        Text {
                                            text: mod.status == "" ? "not applied" : mod.status;
                                            color: Palette.text;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    CheckBox {
                                        text: "select";
                                        checked <=> mod.selected;
                                        enabled: !root.running;
                                    }
                                }
                            }

                            Text {
                                text: mod.description;
                                color: Palette.subtext;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 6px; }

                            Text {
                                text: "What this module does";
                                font-size: 15px;
                                font-weight: 700;
                                color: Palette.accent;
                            }
                            Text {
                                text: mod.details;
                                color: Palette.text;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 10px; }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Button {
                                    text: "Undo";
                                    enabled: !root.running;
                                    clicked => { root.undo-module(root.current-page); }
                                }
                                Button {
                                    text: "Apply";
                                    primary: true;
                                    enabled: !root.running;
                                    clicked => { root.apply-module(root.current-page); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Log strip resize handle ──
        Rectangle {
            height: 5px;
            background: vsplit-ta.has-hover || vsplit-ta.pressed ? Palette.accent : Palette.panel;
            vsplit-ta := TouchArea {
                property <length> start-height;
                property <length> press-y;
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        self.start-height = root.log-height;
                        self.press-y = self.mouse-y;
                    }
                }
                moved => {
                    root.log-height = Math.max(80px, Math.min(500px,
                        self.start-height + (self.press-y - self.mouse-y)));
                }
                mouse-cursor: ns-resize;
            }
        }

        // ── Log strip ──
        Rectangle {
            height: root.log-height;
            background: Palette.panel;
            clip: true;
            VerticalLayout {
                spacing: 0;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 2px;
                    Text {
                        text: "log";
                        font-size: 10px;
                        letter-spacing: 2px;
                        color: Palette.faint;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                    Text {
                        text: root.running ? "⟳ working…" : "";
                        color: Palette.yellow;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                ScrollView {
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 8px;
                        Text {
                            text: root.log-text;
                            color: Palette.text;
                            font-family: "monospace";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
