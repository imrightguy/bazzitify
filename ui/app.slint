import { Button, CheckBox, ScrollView } from "std-widgets.slint";

export struct ModuleInfo {
    name: string,
    description: string,
    selected: bool,
    status: string,
}

export component AppWindow inherits Window {
    title: "bazzitify";
    min-width: 720px;
    min-height: 480px;
    background: #1e1e2e;

    in property <[ModuleInfo]> modules;
    in property <string> log-text;
    in property <bool> running;

    callback apply-selected();
    callback undo-selected();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: "bazzitify — Bazzite-style gaming optimization";
            font-size: 18px;
            color: #cdd6f4;
        }

        ScrollView {
            VerticalLayout {
                spacing: 4px;
                for m in modules: Rectangle {
                    height: 44px;
                    border-radius: 6px;
                    background: #313244;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        alignment: start;
                        CheckBox {
                            checked <=> m.selected;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: m.name; color: #cdd6f4; font-weight: 700; }
                            Text { text: m.description; color: #a6adc8; font-size: 11px; }
                        }
                        Rectangle {
                            horizontal-stretch: 0;
                            Text {
                                text: m.status;
                                color: #a6e3a1;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            background: #181825;
            border-radius: 6px;
            ScrollView {
                Text {
                    text: log-text;
                    color: #94e2d5;
                    font-family: "monospace";
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: "Undo Selected";
                enabled: !running;
                clicked => { root.undo-selected(); }
            }
            Button {
                text: "Apply Selected";
                enabled: !running;
                primary: true;
                clicked => { root.apply-selected(); }
            }
        }
    }
}
