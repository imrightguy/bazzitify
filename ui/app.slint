import { Button, CheckBox, ScrollView, ComboBox } from "std-widgets.slint";

export struct ModuleInfo {
    name: string,
    description: string,
    details: string,
    selected: bool,
    status: string,
}

export struct WizardModule {
    name: string,
    description: string,
    reason: string,
    selected: bool,
}

// ── Palette ──
global Palette {
    out property <color> base: #1e1e2e;
    out property <color> panel: #181825;
    out property <color> surface: #313244;
    out property <color> overlay: #45475a;
    out property <color> text: #cdd6f4;
    out property <color> subtext: #a6adc8;
    out property <color> faint: #6c7086;
    out property <color> accent: #cba6f7;
    out property <color> green: #a6e3a1;
    out property <color> red: #f38ba8;
    out property <color> yellow: #f9e2af;
}

// Sidebar nav row: hover highlight, selected state, optional trailing pill.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    ta := TouchArea {
        clicked => { root.activated(); }
        mouse-cursor: pointer;
    }
    background: root.selected ? Palette.overlay : (ta.has-hover ? Palette.surface : transparent);
    height: 32px;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 10px;
        Text {
            text: root.label;
            color: Palette.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    callback activated();
}


export component AppWindow inherits Window {
    title: @tr("app-title");
    min-width: 760px;
    min-height: 500px;
    preferred-width: 1150px;
    preferred-height: 740px;
    background: Palette.base;

    // Resizable panes
    in-out property <length> sidebar-width: 250px;
    in-out property <length> log-height: 170px;

    in property <[ModuleInfo]> modules;
    in-out property <int> current-page;   // index into modules; -1 = overview
    in-out property <string> log-text;
    in property <bool> running;
    in property <string> distro-info;
    in-out property <bool> dry-run;
    in-out property <bool> select-all-checkbox;
    in property <[string]> profiles;
        in-out property <string> selected-profile;
        in-out property <string> power-profile;  // Current power profile from powerprofilesctl

        // Wizard properties
    in-out property <bool> wizard-active;
    in-out property <int> wizard-step;      // 0=welcome, 1=distro, 2=modules, 3=dry-run, 4=confirm, 5=complete
    in-out property <string> wizard-distro;
    in-out property <string> wizard-preview;
    in-out property <[WizardModule]> wizard-modules;
    in-out property <bool> wizard-confirmed;

    callback select-module(int);
    callback apply-module(int);
    callback undo-module(int);
    callback apply-selected();
    callback undo-selected();
    callback select-all(bool);
    callback clear-selection();
    callback selection-changed();
    callback export-profile(string);
    callback import-profile(string);
    callback load-profiles();
    callback get-power-profile();  // Fetch current power profile from powerprofilesctl

    // Wizard callbacks
    callback wizard-next();
    callback wizard-prev();
    callback wizard-toggle-module(int);
    callback wizard-confirm();
    callback wizard-skip();
    callback rerun-wizard();

    public function append-log(line: string) {
        root.log-text += line + "\n";
    }

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            spacing: 0;

            // ── Sidebar ──
            Rectangle {
                width: root.sidebar-width;
                background: Palette.panel;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: @tr("app-title");
                        font-size: 18px;
                        font-weight: 800;
                        color: Palette.accent;
                    }
                    Text {
                        text: root.distro-info;
                        font-size: 10px;
                        color: Palette.faint;
                    }

                    Rectangle { height: 2px; }

                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: @tr("sidebar-export");
                            enabled: !root.running;
                            clicked => { root.export-profile(root.selected-profile); }
                        }
                        Button {
                            text: @tr("sidebar-import");
                            enabled: !root.running;
                            clicked => { root.import-profile(""); }
                        }
                        Button {
                            text: @tr("sidebar-refresh");
                            enabled: !root.running;
                            clicked => { root.load-profiles(); }
                        }
                        Button {
                            text: @tr("sidebar-rerun-wizard");
                            enabled: !root.running;
                            clicked => { root.rerun-wizard(); }
                        }
                    }

                    Rectangle { height: 4px; }

                    NavItem {
                        label: @tr("sidebar-overview");
                        selected: root.current-page < 0;
                        activated => { root.select-module(-1); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 8px;
                        padding-right: 6px;
                        CheckBox {
                            text: @tr("sidebar-select-all");
                            checked <=> root.select-all-checkbox;
                            enabled: !root.running;
                            toggled => { root.select-all(root.select-all-checkbox); }
                        }
                    }

                    for m[i] in modules: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: root.current-page == i ? Palette.overlay : (row-ta.has-hover ? Palette.surface : transparent);
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 8px;
                            CheckBox {
                                checked <=> m.selected;
                                enabled: !root.running;
                                toggled => { root.selection-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: m.name;
                                    color: Palette.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                            }
                            if m.status == "applied": Rectangle {
                                width: 20px;
                                border-radius: 10px;
                                background: #a6e3a133;
                                Text { text: "✓"; color: Palette.green; font-size: 11px;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if m.status == "undone": Rectangle {
                                width: 20px;
                                border-radius: 10px;
                                background: #89b4fa33;
                                Text { text: "✓"; color: #89b4fa; font-size: 11px;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if m.status == "running…": Rectangle {
                                width: 20px;
                                border-radius: 10px;
                                background: #f9e2af33;
                                Text { text: "⟳"; color: Palette.yellow; font-size: 11px;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if m.status == "failed": Rectangle {
                                width: 20px;
                                border-radius: 10px;
                                background: #f38ba833;
                                Text { text: "✗"; color: Palette.red; font-size: 11px;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        row-ta := TouchArea {
                            clicked => { root.select-module(i); }
                            mouse-cursor: pointer;
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    CheckBox {
                        text: @tr("sidebar-dry-run");
                        checked <=> root.dry-run;
                        enabled: !root.running;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: @tr("sidebar-apply-selected");
                            primary: true;
                            enabled: !root.running;
                            clicked => { root.apply-selected(); }
                        }
                        Button {
                            text: @tr("sidebar-undo-selected");
                            enabled: !root.running;
                            clicked => { root.undo-selected(); }
                        }
                        Button {
                            text: @tr("sidebar-clear-all");
                            enabled: !root.running;
                            clicked => { root.clear-selection(); }
                        }
                    }
                    Text {
                        text: root.running ? @tr("sidebar-status-working") : "";
                        color: Palette.yellow;
                        font-size: 11px;
                    }
                }
            }

            // ── Sidebar resize handle ──
            Rectangle {
                width: 5px;
                background: split-ta.has-hover || split-ta.pressed ? Palette.accent : transparent;
                split-ta := TouchArea {
                    property <length> start-width;
                    property <length> press-x;
                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down {
                            self.start-width = root.sidebar-width;
                            self.press-x = self.mouse-x;
                        }
                    }
                    moved => {
                        root.sidebar-width = Math.max(200px, Math.min(420px,
                            self.start-width + (self.mouse-x - self.press-x)));
                    }
                    mouse-cursor: col-resize;
                }
            }

            // ── Main pane ──
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.base;

                // Wizard page (shown when wizard-active is true)
                if root.wizard-active: ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        // Step indicator
                        HorizontalLayout {
                            spacing: 8px;
                            for i in 6: Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: i <= root.wizard-step ? Palette.accent : Palette.surface;
                                Text {
                                    text: "{i + 1}";
                                    color: i <= root.wizard-step ? Palette.base : Palette.subtext;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Welcome step
                        if root.wizard-step == 0: Rectangle {
                            VerticalLayout {
                                spacing: 12px;
                                Text {
                                    text: @tr("wizard-welcome-title");
                                    font-size: 28px;
                                    font-weight: 800;
                                    color: Palette.text;
                                }
                                Text {
                                    text: @tr("wizard-welcome-description");
                                    color: Palette.subtext;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 20px; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    Button {
                                        text: @tr("wizard-welcome-skip");
                                        enabled: !root.running;
                                        clicked => { root.wizard-skip(); }
                                    }
                                    Button {
                                        text: @tr("wizard-welcome-get-started");
                                        primary: true;
                                        enabled: !root.running;
                                        clicked => { root.wizard-next(); }
                                    }
                                }
                            }
                        }

                        // Distro detection step
                        if root.wizard-step == 1: Rectangle {
                            VerticalLayout {
                                spacing: 12px;
                                Text {
                                    text: @tr("wizard-distro-title");
                                    font-size: 28px;
                                    font-weight: 800;
                                    color: Palette.text;
                                }
                                Text {
                                    text: @tr("wizard-distro-detected");
                                    color: Palette.subtext;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Rectangle {
                                    height: 60px;
                                    border-radius: 8px;
                                    background: Palette.surface;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        alignment: center;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            background: Palette.accent;
                                            border-radius: 24px;
                                            Text { text: @tr("emoji-linux"); font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.wizard-distro;
                                                font-size: 18px;
                                                font-weight: 700;
                                                color: Palette.text;
                                            }
                                            Text {
                                                text: @tr("wizard-distro-source");
                                                font-size: 11px;
                                                color: Palette.faint;
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("wizard-distro-confirm");
                                    color: Palette.faint;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 20px; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    Button {
                                        text: @tr("wizard-distro-back");
                                        enabled: !root.running;
                                        clicked => { root.wizard-prev(); }
                                    }
                                    Button {
                                        text: @tr("wizard-distro-continue");
                                        primary: true;
                                        enabled: !root.running;
                                        clicked => { root.wizard-next(); }
                                    }
                                }
                            }
                        }

                        // Module selection step
                        if root.wizard-step == 2: Rectangle {
                            VerticalLayout {
                                spacing: 12px;
                                Text {
                                    text: @tr("wizard-modules-title");
                                    font-size: 28px;
                                    font-weight: 800;
                                    color: Palette.text;
                                }
                                Text {
                                    text: @tr("wizard-modules-description");
                                    color: Palette.subtext;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                for m[i] in wizard-modules: Rectangle {
                                    height: 72px;
                                    border-radius: 8px;
                                    background: Palette.surface;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;
                                        CheckBox {
                                            checked <=> m.selected;
                                            enabled: !root.running;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: m.name;
                                                color: Palette.text;
                                                font-size: 14px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: m.description;
                                                color: Palette.subtext;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: @tr("wizard-modules-reason-prefix") + " " + m.reason;
                                                color: Palette.yellow;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                                max-width: 300px;
                                            }
                                        }
                                    }
                                }
                                Rectangle { height: 20px; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    Button {
                                        text: @tr("wizard-modules-back");
                                        enabled: !root.running;
                                        clicked => { root.wizard-prev(); }
                                    }
                                    Button {
                                        text: @tr("wizard-modules-preview");
                                        primary: true;
                                        enabled: !root.running;
                                        clicked => { root.wizard-next(); }
                                    }
                                }
                            }
                        }

                        // Dry-run preview step
                        if root.wizard-step == 3: Rectangle {
                            VerticalLayout {
                                spacing: 12px;
                                Text {
                                    text: @tr("wizard-dryrun-title");
                                    font-size: 28px;
                                    font-weight: 800;
                                    color: Palette.text;
                                }
                                Text {
                                    text: @tr("wizard-dryrun-description");
                                    color: Palette.subtext;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Rectangle {
                                    border-radius: 8px;
                                    background: #1a1a2e;
                                    padding: 16px;
                                    Text {
                                        text: root.wizard-preview;
                                        color: Palette.green;
                                        font-family: "monospace";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                                Rectangle { height: 20px; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    Button {
                                        text: @tr("wizard-dryrun-back");
                                        enabled: !root.running;
                                        clicked => { root.wizard-prev(); }
                                    }
                                    Button {
                                        text: @tr("wizard-dryrun-apply");
                                        primary: true;
                                        enabled: !root.running;
                                        clicked => { root.wizard-next(); }
                                    }
                                }
                            }
                        }

                        // Confirm step
                        if root.wizard-step == 4: Rectangle {
                            VerticalLayout {
                                spacing: 12px;
                                Text {
                                    text: @tr("wizard-confirm-title");
                                    font-size: 28px;
                                    font-weight: 800;
                                    color: Palette.text;
                                }
                                Text {
                                    text: @tr("wizard-confirm-description");
                                    color: Palette.subtext;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                CheckBox {
                                    text: @tr("wizard-confirm-checkbox");
                                    checked <=> root.wizard-confirmed;
                                    font-size: 13px;
                                }
                                Rectangle { height: 20px; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    Button {
                                        text: @tr("wizard-confirm-back");
                                        enabled: !root.running;
                                        clicked => { root.wizard-prev(); }
                                    }
                                    Button {
                                        text: @tr("wizard-confirm-apply");
                                        primary: true;
                                        enabled: root.wizard-confirmed && !root.running;
                                        clicked => { root.wizard-confirm(); }
                                    }
                                }
                            }
                        }

                        // Complete step
                        if root.wizard-step == 5: Rectangle {
                            VerticalLayout {
                                spacing: 12px;
                                Text {
                                    text: @tr("wizard-complete-title");
                                    font-size: 28px;
                                    font-weight: 800;
                                    color: Palette.green;
                                }
                                Text {
                                    text: @tr("wizard-complete-description");
                                    color: Palette.subtext;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 20px; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    Button {
                                        text: @tr("wizard-complete-finish");
                                        primary: true;
                                        enabled: !root.running;
                                        clicked => { root.wizard-confirm(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Overview page
                if root.current-page < 0 && !root.wizard-active: ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;

                        Text {
                            text: @tr("overview-title");
                            font-size: 22px;
                            font-weight: 800;
                            color: Palette.text;
                        }
                        Text {
                            text: @tr("overview-description");
                            color: Palette.subtext;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Rectangle { height: 8px; }

                        for m[i] in modules: Rectangle {
                            height: 64px;
                            border-radius: 8px;
                            row-hover := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-module(i); }
                            }
                            background: row-hover.has-hover ? Palette.overlay : Palette.surface;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: m.name;
                                        color: Palette.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: m.description;
                                        color: Palette.subtext;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: @tr("sidebar-module-open");
                                        clicked => { root.select-module(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.current-page >= 0 && root.current-page < modules.length: Rectangle {
                    property <ModuleInfo> mod: modules[root.current-page];

                    ScrollView {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: mod.name;
                                    font-size: 22px;
                                    font-weight: 800;
                                    color: Palette.text;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        border-radius: 11px;
                                        background: mod.status == "applied" ? #a6e3a155 :
                                                    (mod.status == "undone" ? #89b4fa55 :
                                                     (mod.status == "running…" ? #f9e2af55 :
                                                      (mod.status == "failed" ? #f38ba855 : Palette.surface)));
                                        width: 92px;
                                        height: 22px;
                                        Text {
                                            text: mod.status == "" ? @tr("module-status-not-applied") : mod.status;
                                            color: Palette.text;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    CheckBox {
                                        text: @tr("sidebar-select-checkbox");
                                        checked <=> mod.selected;
                                        enabled: !root.running;
                                    }
                                }
                            }

                            Text {
                                text: mod.description;
                                color: Palette.subtext;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 6px; }

                            Text {
                                text: @tr("module-details-heading");
                                font-size: 15px;
                                font-weight: 700;
                                color: Palette.accent;
                            }
                            Text {
                                text: mod.details;
                                color: Palette.text;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            // Power profile status for power-profiles module
                            if mod.name == "power-profiles" && root.power-profile != "" : Rectangle {
                                background: Palette.surface;
                                border-radius: 6px;
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: @tr("power-profile-current-label");
                                        font-weight: 700;
                                        color: Palette.subtext;
                                    }
                                    Text {
                                        text: root.power-profile;
                                        font-weight: 700;
                                        color: Palette.accent;
                                    }
                                }
                            }

                            Rectangle { height: 10px; }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Button {
                                    text: @tr("module-detail-undo");
                                    enabled: !root.running;
                                    clicked => { root.undo-module(root.current-page); }
                                }
                                Button {
                                    text: @tr("module-detail-apply");
                                    primary: true;
                                    enabled: !root.running;
                                    clicked => { root.apply-module(root.current-page); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Log strip resize handle ──
        Rectangle {
            height: 5px;
            background: vsplit-ta.has-hover || vsplit-ta.pressed ? Palette.accent : Palette.panel;
            vsplit-ta := TouchArea {
                property <length> start-height;
                property <length> press-y;
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        self.start-height = root.log-height;
                        self.press-y = self.mouse-y;
                    }
                }
                moved => {
                    root.log-height = Math.max(80px, Math.min(500px,
                        self.start-height + (self.press-y - self.mouse-y)));
                }
                mouse-cursor: ns-resize;
            }
        }

        // ── Log strip ──
        Rectangle {
            height: root.log-height;
            background: Palette.panel;
            clip: true;
            VerticalLayout {
                spacing: 0;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 2px;
                    Text {
                        text: @tr("log-label");
                        font-size: 10px;
                        letter-spacing: 2px;
                        color: Palette.faint;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                    Text {
                        text: root.running ? @tr("log-status-working") : "";
                        color: Palette.yellow;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                ScrollView {
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 8px;
                        Text {
                            text: root.log-text;
                            color: Palette.text;
                            font-family: "monospace";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
